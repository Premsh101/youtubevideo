# --- Vertex AI (Gemini, Imagen/Flash-Image, Veo) + Cloud Text-to-Speech ---
# Path to the service-account JSON downloaded from GCP (roles: Vertex AI User, Cloud TTS user)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/vertex-service-account.json
# ...or paste the JSON content instead of a path:
# VERTEX_SA_JSON={"type":"service_account",...}
GOOGLE_CLOUD_PROJECT=            # optional, read from the JSON if blank
GOOGLE_CLOUD_LOCATION=us-central1

# Models (override if Google renames them)
TEXT_MODEL=gemini-2.5-flash
IMAGE_MODEL=gemini-2.5-flash-image
VEO_MODEL=veo-3.1-fast-generate-001
TTS_VOICE_EN=en-IN-Neural2-A
TTS_VOICE_HI=hi-IN-Neural2-A

# Pricing (USD) — edit when Google changes list prices; shown in ₹ via USD_TO_INR
USD_TO_INR=84
# PRICE_IMAGE_PER_UNIT=0.039
# PRICE_VEO_PER_SECOND=0.15
# PRICE_TTS_PER_1M_CHARS=16

# Video
VIDEO_W=1280
VIDEO_H=720
TARGET_SECONDS=120

# YouTube (OAuth client JSON from the same GCP project, "Web application" type)
YOUTUBE_CLIENT_SECRETS=data/secrets/youtube_client_secret.json
YOUTUBE_REDIRECT_URI=http://localhost:8000/youtube/oauth2callback
YOUTUBE_PRIVACY=private

# Optional login (off by default). Set APP_PASSWORD to require a username/password.
# APP_USER=admin
# APP_PASSWORD=

# Optional: real sung vocals (ElevenLabs Music API). Leave blank to use spoken Google TTS only.
ELEVENLABS_API_KEY=
# PRICE_SUNG_PER_MINUTE=0.21   # Starter ≈ ₹17.6/min; Creator ≈ ₹16/min

# Run without any Google credentials (placeholder art + hummed voice) for testing
MOCK_AI=0
